# URL base del API Gateway (sin "/" final). Ej.: https://abc123.execute-api.us-east-1.amazonaws.com/prod
VITE_API_BASE_URL=
# "true" usa el backend simulado en memoria; "false" llama al API real
VITE_MOCK=true
# Opcional: key gratuita de CARTO (dashboard.basemaps.carto.com). Con ella el mapa usa CARTO dark_all (NOC)
# y voyager (portal). Es pública por naturaleza: restríngela a tu dominio. Vacía = OpenStreetMap.
VITE_CARTO_API_KEY=
# Opcional: URL de tiles propia (tiene prioridad sobre CARTO).
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
